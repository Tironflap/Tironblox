{
  "manifest_version": 3,
  "name": "Roblox Badge Gamerscore",
  "version": "1.1",
  "description": "Shows Badge Gamerscore on profiles, inventory and badge pages",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://badges.roproxy.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}